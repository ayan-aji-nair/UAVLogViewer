# UAV Log Viewer Backend Environment Variables
# Copy this file to .env and fill in your values

# Required: OpenAI API Key for the AI chatbot
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# Optional: OpenAI Model (default: gpt-4)
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4

# Optional: Redis Configuration (defaults to localhost)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional: Debug mode (default: false)
# Set to true for verbose logging
DEBUG=false

# Optional: CORS Origins (comma-separated list)
# Defaults to localhost development URLs
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Optional: Session TTL in seconds (default: 3600 = 1 hour)
SESSION_TTL=3600

# Optional: Log Level (default: info)
LOG_LEVEL=info
